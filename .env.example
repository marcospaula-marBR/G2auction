# ──────────────────────────────────────────────────────────────────────────
# Smart Leilões API v3 — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes de rodar.
# NUNCA commite o arquivo .env no repositório!
# ──────────────────────────────────────────────────────────────────────────

# ── Banco de Dados ────────────────────────────────────────────────────────
# Supabase PostgreSQL (produção):
# DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJECT_ID].supabase.co:5432/postgres
#
# SQLite local (desenvolvimento):
DATABASE_URL=sqlite:///./leiloes_v3.db

# ── Supabase (para features futuras de Auth/Storage) ─────────────────────
SUPABASE_URL=https://[SEU_PROJECT_ID].supabase.co
SUPABASE_SERVICE_KEY=[SUA_SERVICE_ROLE_KEY]

# ── Segurança ─────────────────────────────────────────────────────────────
# Mude para um valor longo e aleatório em produção!
ADMIN_SECRET_KEY=minha_chave_admin_ultra_secreta_min_32_chars

# ── CORS ──────────────────────────────────────────────────────────────────
# Em desenvolvimento: * (aceita qualquer origem)
# Em produção: lista separada por vírgulas
CORS_ORIGINS=*
# CORS_ORIGINS=https://g2auction.com.br,https://fliplink.smartleiloes.com.br,chrome-extension://SEU_ID

# ── Ambiente ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_VERSION=3.0.0
LOG_LEVEL=INFO

# ── Calculadora Financeira (atualizável sem deploy) ───────────────────────
# Taxa SELIC atual (% a.a.) — atualizar conforme decisão do BACEN
SELIC_RATE_ANNUAL=10.75
# Comissão padrão do leiloeiro (% sobre o lance) — definido por lei
COMISSAO_LEILOEIRO_PCT=5.0
# Alíquota de IR sobre ganho de capital (simplificada)
IR_GANHO_CAPITAL_PCT=15.0
